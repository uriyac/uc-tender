# --- מנוע ---
# stub  = מימוש דטרמיניסטי ללא מפתח (ברירת מחדל בשלד)
# claude = מימוש אמיתי מול Claude API (דורש מפתח למטה)
ENGINE=stub

# נדרש רק כש-ENGINE=claude. להפעלת המנוע האמיתי: הרץ `npm i @anthropic-ai/sdk`,
# הזן מפתח כאן, וקבע ENGINE=claude. השומר (אפס-הזיות) רץ בכל מקרה.
ANTHROPIC_API_KEY=

# מודל Claude (ברירת מחדל: claude-opus-5). אופציונלי.
CLAUDE_MODEL=claude-opus-5

# פורט השרת
PORT=3000
