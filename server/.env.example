# --- מנוע ---
# stub   = מימוש דטרמיניסטי ללא מפתח (ברירת מחדל בשלד)
# claude = מימוש אמיתי מול Claude API (דורש מפתח למטה)
ENGINE=stub

# נדרש רק כש-ENGINE=claude. להפעלת המנוע האמיתי ("נקודת ההפעלה"):
#   1) npm i @anthropic-ai/sdk   2) הזן מפתח כאן   3) ENGINE=claude
# השומר (אפס-הזיות) רץ בכל מקרה. /api/health יראה engine.ready=true כשהמפתח קיים.
ANTHROPIC_API_KEY=

# מודל Claude (ברירת מחדל: claude-opus-5). אופציונלי.
CLAUDE_MODEL=claude-opus-5

# --- שרת ---
PORT=3000

# הזרעת DB: empty = רק superadmin (בלי חשבון דמו). ריק/כל-ערך-אחר = חשבון דמו מלא.
# משפיע רק על DB חדש (app.sqlite שלא קיים עדיין).
SEED=empty

# לוג בקשות API (זמן-תגובה + סטטוס). ברירת מחדל: on.
LOG_REQUESTS=on

# --- superadmin (הספק) — נוצר פעם אחת בהזרעה ראשונה ---
SUPERADMIN_EMAIL=admin@uctender.local
SUPERADMIN_PASSWORD=admin1234
